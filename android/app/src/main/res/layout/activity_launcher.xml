<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/missingRomContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center|top"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        app:srcCompat="@drawable/logo" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="50dp" />

    <TextView
        android:id="@+id/infoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="ROM not found. Select your ROM to continue."
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <Button
        android:id="@+id/pickRomButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E5FA8"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:text="Select ROM"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/startButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:alpha="0.5"
        android:background="#2873C2"
        android:enabled="false"
        android:paddingLeft="150dp"
        android:paddingTop="30dp"
        android:paddingRight="150dp"
        android:paddingBottom="30dp"
        android:text="Start"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <!-- Net play (experimental, port-net). Host = Combat Simulator server;
         Join = connect to a host's IP. Typed here because the 2D panel gets the
         Quest system keyboard, which the in-game menu does not. -->
    <TextView
        android:id="@+id/netLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Net play (experimental)"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <RadioGroup
        android:id="@+id/netModeGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/netModeOff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Offline"
            android:textColor="#FFFFFF" />

        <RadioButton
            android:id="@+id/netModeHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Host"
            android:textColor="#FFFFFF" />

        <RadioButton
            android:id="@+id/netModeJoin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Join"
            android:textColor="#FFFFFF" />
    </RadioGroup>

    <EditText
        android:id="@+id/netAddress"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Host address (IP or IP:port)"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888" />

    <TextView
        android:id="@+id/netInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#AAAAAA"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/resetGraphicsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="#1E5FA8"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:text="Reset graphics settings"
            android:textColor="#FFFFFF" />
    </FrameLayout>

</LinearLayout>
